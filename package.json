{
	"name": "hunter-chatgpt-mcp",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@12.2.1",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"lint": "oxlint src/ bundle/ vite.config.ts",
		"lint:fix": "oxlint --fix src/ bundle/ vite.config.ts",
		"format": "oxfmt --write src/ bundle/ vite.config.ts",
		"format:check": "oxfmt --check src/ bundle/ vite.config.ts",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
		"test": "vitest run -c vitest.unit.config.mts",
		"test:docs": "vitest run -c vitest.docs.config.mts",
		"docs:update": "vitest run -c vitest.docs.config.mts -u",
		"test:watch": "vitest -c vitest.unit.config.mts",
		"dev:widgets": "vite",
		"build:widgets": "rm -rf dist/assets && pnpm run build:widgets:company && pnpm run build:widgets:discover",
		"build:widgets:company": "WIDGET_ENTRY=company-widget vite build",
		"build:widgets:discover": "WIDGET_ENTRY=discover-widget vite build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@openai/apps-sdk-ui": "^0.2.2",
		"@sentry/cloudflare": "^11.10.0",
		"fs-extra": "^11.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.1"
	}
}
